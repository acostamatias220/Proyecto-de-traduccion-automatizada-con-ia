			Fade("_kg_chara_white_ノーコ",300,0,null,true);
		}else if($kgCharaOrder[0]=="似鳥"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,720,0,180,332,"cg/sys/rate/カゴメ成功文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_アップ_似鳥",2300,550,0,"cg/sys/rate/result/st似鳥_アップ.png");
			Fade("_kg_chara_white_似鳥",0,1000,null,false);
			Fade("_kg_chara_white_似鳥",300,0,null,true);
		}else if($kgCharaOrder[0]=="フウリ"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,900,0,180,332,"cg/sys/rate/カゴメ成功文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_アップ_フウリ",2300,675,0,"cg/sys/rate/result/stフウリ_アップ.png");
			Fade("_kg_chara_white_フウリ",0,1000,null,false);
			Fade("_kg_chara_white_フウリ",300,0,null,true);
		}
		Fade("_kg_title",0,1000,null,false);
		Fade("_kg_effect",0,1000,null,false);
		Fade("_kg_unknown*",0,1000,null,false);
		Fade("_kg_no*",0,1000,null,false);
		Move("_kg_bg_kagome_mov",500,@0,576,Axl1,true);
		CreateMovie("_kg_bird_mov",2450,48,0,false,true,"dx/bird.ngs");
		Wait(300);
		Fade("_kg_unknown1",300,0,null,150);
		Fade("_kg_unknown2",300,0,null,100);
		Fade("_kg_unknown3",300,0,null,100);
		WaitAction("_kg_bird_mov",true);
		CreateColor("@RateWindow/_kg_color",2510,0,0,1024,576,WHITE);
		Fade("@RateWindow/_kg_color",0,0,null,false);
		Fade("@RateWindow/_kg_color",1000,1000,null,true);
	}else{
		// 失敗
		CreateSound("_kg_se",SE,"sound/se/se擬音_カゴメアソビ失敗.ogg");
		Request("_kg_se",Play);
		Wait(800);
		if($カゴメフラグ名=="flkagome1"||$カゴメフラグ名=="flkagome2b"){
			//該当人物意外にカゴメアソビを行った場合
		}else if($kgCharaOrder[0]=="沙紅羅"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,0,0,180,332,"cg/sys/rate/カゴメ失敗文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_赤_沙紅羅",2300,50,0,"cg/sys/rate/result/st沙紅羅_赤.png");
		}else if($kgCharaOrder[0]=="千秋"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,180,0,180,332,"cg/sys/rate/カゴメ失敗文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_赤_千秋",2300,175,0,"cg/sys/rate/result/st千秋_赤.png");
		}else if($kgCharaOrder[0]=="恵那"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,360,0,180,332,"cg/sys/rate/カゴメ失敗文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_赤_恵那",2300,300,0,"cg/sys/rate/result/st恵那_赤.png");
		}else if($kgCharaOrder[0]=="ノーコ"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,540,0,180,332,"cg/sys/rate/カゴメ失敗文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_赤_ノーコ",2300,425,0,"cg/sys/rate/result/stノーコ_赤.png");
		}else if($kgCharaOrder[0]=="似鳥"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,720,0,180,332,"cg/sys/rate/カゴメ失敗文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_赤_似鳥",2300,550,0,"cg/sys/rate/result/st似鳥_赤.png");
		}else if($kgCharaOrder[0]=="フウリ"){
			CreateClipTexture("_kg_chara_msg_message",2500,822,97,900,0,180,332,"cg/sys/rate/カゴメ失敗文言.png");
			Fade("_kg_chara_msg_message",0,0,null,false);
			Fade("_kg_chara_msg_*",200,1000,null,false);
			CreateTexture("_kg_chara_赤_フウリ",2300,675,0,"cg/sys/rate/result/stフウリ_赤.png");
		}
		CreateTexture("_kg_fail",2450,50,0,"cg/sys/rate/result/カゴメアソビ失敗.png");
		CreateColor("_kg_ef",2490,0,0,1024,576,WHITE);
		Fade("_kg_title",0,1000,null,false);
		Fade("_kg_effect",0,1000,null,false);
		Fade("_kg_unknown*",0,1000,null,false);
		Fade("_kg_no*",0,1000,null,false);
		Fade("_kg_bg_kagome_mov",0,0,null,false);
		Fade("_kg_ef",150,0,null,true);
		Wait(300);
		Fade("_kg_unknown1",300,0,null,150);
		Fade("_kg_unknown2",200,0,null,100);
		Fade("_kg_unknown3",150,0,null,100);
		Wait(300);
		CreateColor("_kg_ef",2490,0,0,1024,576,BLACK);
		Fade("_kg_ef",0,0,null,false);
		Fade("_kg_ef",500,1000,null,true);
		CreateColor("@RateWindow/_kg_color",2510,0,0,1024,576,BLACk);
		Fade("@RateWindow/_kg_color",0,0,null,false);
		Fade("@RateWindow/_kg_color",1000,1000,null,true);
	}
}
